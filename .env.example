NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
PLAYWRIGHT_BASE_URL=
# Tests only (wish list): the one origin of a test shop the link reader may open
# even if local, e.g. http://127.0.0.1:4010. Ignored on Vercel.
SHOP_LINK_TEST_ORIGIN=
# Linked calendars (#34, #35, #37). Names only: the values are set in the
# environment of the server and never committed.
# Bearer secret of the synchronisation service (at least 32 characters); same
# value as `calendar_sync_secret` in the Supabase Vault.
CALENDAR_SYNC_SECRET=
# Key for the credentials of the external accounts: 32 random bytes in base64.
# Never in the database. Optional version (default 1); after a rotation the old
# key stays available as CALENDAR_ENCRYPTION_KEY_V<version>.
CALENDAR_ENCRYPTION_KEY=
CALENDAR_ENCRYPTION_KEY_VERSION=
# Fake provider for development and tests (1 to enable). Never in production.
CALENDAR_FAKE_PROVIDER=
# OAuth clients of the calendar permissions.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
TEST_USER_B2_EMAIL=
TEST_USER_B2_PASSWORD=
TEST_USER_C_EMAIL=
TEST_USER_C_PASSWORD=
